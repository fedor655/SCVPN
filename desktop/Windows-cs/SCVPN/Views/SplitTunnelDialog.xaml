<Window x:Class="SCVPN.Views.SplitTunnelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:SCVPN.Theme"
        xmlns:controls="clr-namespace:SCVPN.Controls"
        xmlns:views="clr-namespace:SCVPN.Views"
        Title="Раздельное туннелирование"
        Width="{x:Static theme:Metrics.SheetWidth}"
        MinWidth="{x:Static theme:Metrics.SheetWidth}"
        Height="{x:Static views:SplitTunnelDialog.DialogHeight}"
        MinHeight="{x:Static views:SplitTunnelDialog.DialogMinHeight}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{x:Static theme:Palette.SurfaceBrush}"
        Foreground="{x:Static theme:Palette.TextBrush}"
        FontFamily="{x:Static views:SplitTunnelDialog.UiFont}"
        FontSize="{x:Static theme:Metrics.FsRowTitle}"
        TextOptions.TextFormattingMode="Display"
        Loaded="OnLoaded">

    <!-- Отступы и просветы собраны в статические поля код-бехайнда: Thickness и
         CornerRadius не собираются в разметке из отдельных чисел, а вписывать
         числа руками нельзя — они живут в Theme.Metrics. -->
    <Grid Margin="{x:Static views:SplitTunnelDialog.SheetPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Три взаимоисключающих варианта. Два последних различает уже
             sing-box по процессу-владельцу соединения, поэтому они работают
             только в TUN-режиме: системный прокси — это настройка ОС,
             приложения ходят в неё сами, и различить их там нечем. -->
        <RadioButton x:Name="RbOff" Grid.Row="0" GroupName="split"
                     Content="Всё через VPN"
                     Margin="{x:Static views:SplitTunnelDialog.RadioMargin}"
                     Checked="OnModeChanged" />
        <RadioButton x:Name="RbExclude" Grid.Row="1" GroupName="split"
                     Content="Всё через VPN, кроме выбранных приложений"
                     Margin="{x:Static views:SplitTunnelDialog.RadioMargin}"
                     Checked="OnModeChanged" />
        <RadioButton x:Name="RbInclude" Grid.Row="2" GroupName="split"
                     Content="Только выбранные приложения через VPN"
                     Margin="{x:Static views:SplitTunnelDialog.RadioMargin}"
                     Checked="OnModeChanged" />

        <!-- Предупреждение про TUN: без него выбор по приложениям выглядит
             работающим и в режиме системного прокси, где он не действует. -->
        <TextBlock Grid.Row="3" TextWrapping="Wrap"
                   Margin="{x:Static views:SplitTunnelDialog.NoteMargin}"
                   FontSize="{x:Static theme:Metrics.FsDetail}"
                   Foreground="{x:Static theme:Palette.DimBrush}">Разбор по приложениям работает в режиме «TUN — весь трафик»:<LineBreak />системный прокси приложения не различает.</TextBlock>

        <controls:TrackedTextBlock Grid.Row="4" Text="ПРИЛОЖЕНИЯ"
                                   Margin="{x:Static views:SplitTunnelDialog.GapBelow}"
                                   FontSize="{x:Static theme:Metrics.FsSection}"
                                   FontWeight="Bold"
                                   Tracking="{x:Static theme:Metrics.SectionTracking}"
                                   Foreground="{x:Static theme:Palette.DimBrush}" />

        <!-- Подсказки в поле ввода у WPF нет: TextBox рисует только текст,
             поэтому «Поиск по имени…» лежит поверх и гаснет, как только в поле
             что-то набрали. Её левое поле выставляет OnLoaded — по настоящим
             Padding и BorderThickness поля, а не по числу из разметки. -->
        <Grid Grid.Row="5" Margin="{x:Static views:SplitTunnelDialog.GapBelow}">
            <TextBox x:Name="Search" VerticalContentAlignment="Center"
                     TextChanged="OnSearchChanged" />
            <TextBlock x:Name="SearchHint" Text="Поиск по имени…"
                       IsHitTestVisible="False"
                       VerticalAlignment="Center"
                       Foreground="{x:Static theme:Palette.MutedBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Список приложений — вложенная панель: заливка, волосяная рамка и то
             самое скругление 8, что у полей ввода и карточек подписки. -->
        <Border x:Name="AppsBox" Grid.Row="6"
                Margin="{x:Static views:SplitTunnelDialog.GapBelow}"
                Padding="{x:Static views:SplitTunnelDialog.BoxPadding}"
                Background="{x:Static theme:Palette.BgBrush}"
                BorderBrush="{x:Static theme:Palette.StrokeBrush}"
                BorderThickness="{x:Static views:SplitTunnelDialog.BoxBorder}"
                CornerRadius="{x:Static views:SplitTunnelDialog.BoxCornerRadius}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="AppsPanel" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="7" Orientation="Horizontal"
                    Margin="{x:Static views:SplitTunnelDialog.GapBelow}">
            <Button Content="Добавить вручную…" Click="OnAddManual"
                    Margin="{x:Static views:SplitTunnelDialog.ButtonGap}" />
            <Button Content="Обновить список" Click="OnReload" />
        </StackPanel>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" IsCancel="True"
                    Margin="{x:Static views:SplitTunnelDialog.ButtonGap}" />
            <Button Content="Сохранить" IsDefault="True" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
