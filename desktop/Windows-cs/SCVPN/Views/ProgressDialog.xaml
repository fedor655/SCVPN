<Window x:Class="SCVPN.Views.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:SCVPN.Theme"
        Title="Загрузка"
        Width="{x:Static theme:Metrics.SheetWidth}"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{x:Static theme:Palette.SurfaceBrush}"
        Foreground="{x:Static theme:Palette.TextBrush}"
        FontFamily="{x:Static theme:Metrics.UiFontFamily}"
        FontSize="{x:Static theme:Metrics.FsRowTitle}"
        TextOptions.TextFormattingMode="Display"
        Closing="OnClosing">

    <!-- Отступы, высота полосы и шрифт выставляются в конструкторе: Thickness
         из XAML одним числом не собрать, а числа обязаны приходить из Metrics,
         а не из разметки. -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Текущий шаг: сюда приходят те же строки, что и в лог главного окна. -->
        <TextBlock x:Name="Label" Grid.Row="0"
                   TextWrapping="Wrap"
                   Foreground="{x:Static theme:Palette.TextBrush}" />

        <!-- Полоса нарисована из двух прямоугольников, а не взята готовым
             ProgressBar: системный шаблон ProgressBar цветной и светлый, и
             перекрашивать его целиком вышло бы длиннее, чем нарисовать. -->
        <Border x:Name="Track" Grid.Row="1" ClipToBounds="True"
                Background="{x:Static theme:Palette.StrokeBrush}"
                SizeChanged="OnTrackResized">
            <Border x:Name="Fill" Width="0" HorizontalAlignment="Left"
                    Background="{x:Static theme:Palette.AccentBrush}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="FillShift" />
                </Border.RenderTransform>
            </Border>
        </Border>

        <TextBlock x:Name="Counter" Grid.Row="2"
                   HorizontalAlignment="Right"
                   Foreground="{x:Static theme:Palette.DimBrush}"
                   FontSize="{x:Static theme:Metrics.FsDetail}" />

        <Button x:Name="CancelButton" Grid.Row="3"
                Content="Отмена"
                HorizontalAlignment="Right"
                Click="OnCancel" />
    </Grid>
</Window>
