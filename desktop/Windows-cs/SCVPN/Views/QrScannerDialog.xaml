<Window x:Class="SCVPN.Views.QrScannerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:SCVPN.Theme"
        Title="Сканировать QR-код"
        Width="{x:Static theme:Metrics.SheetWidth}"
        MinWidth="{x:Static theme:Metrics.SheetWidth}"
        Background="{x:Static theme:Palette.SurfaceBrush}"
        Foreground="{x:Static theme:Palette.TextBrush}"
        FontSize="{x:Static theme:Metrics.FsRowTitle}"
        TextOptions.TextFormattingMode="Display"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ContentRendered="OnContentRendered">

    <!-- Отступы, скругления и толщины собираются в коде: Thickness и
         CornerRadius из отдельных чисел в XAML не составить, а числа обязаны
         остаться в Metrics. См. ApplyMetrics(). -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="VideoBox" Grid.Row="0"
                Background="{x:Static theme:Palette.BgBrush}"
                BorderBrush="{x:Static theme:Palette.StrokeBrush}">
            <Grid>
                <!-- Зеркалим только показ, а не сам кадр: так держать телефон
                     перед камерой привычнее, но распознавать надо
                     незеркальную картинку — отражённый QR читается хуже. -->
                <Image x:Name="VideoImage" Stretch="Uniform" Visibility="Collapsed"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform ScaleX="-1" />
                    </Image.RenderTransform>
                </Image>

                <!-- Пока картинки нет, здесь словами написано, почему её нет:
                     пустой прямоугольник ничего человеку не объясняет. -->
                <TextBlock x:Name="VideoMessage"
                           Text="Открываю камеру…"
                           TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{x:Static theme:Palette.DimBrush}"
                           FontSize="{x:Static theme:Metrics.FsBody}" />
            </Grid>
        </Border>

        <TextBlock x:Name="Hint" Grid.Row="1"
                   Text="Поднеси QR-код подписки к камере"
                   TextAlignment="Center" HorizontalAlignment="Center"
                   Foreground="{x:Static theme:Palette.DimBrush}"
                   FontSize="{x:Static theme:Metrics.FsBody}" />

        <Grid x:Name="ButtonRow" Grid.Row="2">
            <Button x:Name="SwitchButton" Content="Другая камера"
                    HorizontalAlignment="Left" Click="OnSwitchCamera" />
            <Button x:Name="CancelButton" Content="Отмена"
                    HorizontalAlignment="Right" IsCancel="True" />
        </Grid>
    </Grid>
</Window>
