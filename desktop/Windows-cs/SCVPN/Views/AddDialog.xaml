<Window x:Class="SCVPN.Views.AddDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:SCVPN.Theme"
        Title="Добавить"
        Width="{x:Static theme:Metrics.SheetWidth}"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{x:Static theme:Palette.SurfaceBrush}"
        Foreground="{x:Static theme:Palette.TextBrush}"
        FontFamily="{x:Static theme:Metrics.UiFontFamily}"
        FontSize="{x:Static theme:Metrics.FsRowTitle}"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnPreviewKeyDown">

    <!-- Отступы, просветы и рамки выставляются в конструкторе: Thickness и
         CornerRadius из XAML одним числом не собрать, а числа обязаны
         приходить из Metrics, а не из разметки. -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Caption"
                   Grid.Row="0"
                   TextWrapping="Wrap"
                   Foreground="{x:Static theme:Palette.DimBrush}"
                   FontSize="{x:Static theme:Metrics.FsBody}">Вставь ссылку сервера (vless:// / vmess:// / trojan:// / ss://)<LineBreak />или URL подписки — либо отсканируй QR-код.</TextBlock>

        <Grid x:Name="InputHost" Grid.Row="1">
            <TextBox x:Name="Input"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     Background="{x:Static theme:Palette.BgBrush}"
                     Foreground="{x:Static theme:Palette.TextBrush}"
                     BorderBrush="{x:Static theme:Palette.StrokeBrush}"
                     CaretBrush="{x:Static theme:Palette.TextBrush}"
                     SelectionBrush="{x:Static theme:Palette.StrokeBrush}"
                     SelectionTextBrush="{x:Static theme:Palette.TextBrush}"
                     FontFamily="{x:Static theme:Metrics.MonoFontFamily}"
                     FontSize="{x:Static theme:Metrics.FsDetail}"
                     TextChanged="OnInputChanged" />

            <!-- Подсказки в пустом поле у WPF нет — рисуем её сами поверх
                 поля и убираем на первом же символе. -->
            <TextBlock x:Name="Placeholder"
                       Text="vless://…  или  https://…"
                       IsHitTestVisible="False"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Foreground="{x:Static theme:Palette.MutedBrush}"
                       FontFamily="{x:Static theme:Metrics.MonoFontFamily}"
                       FontSize="{x:Static theme:Metrics.FsDetail}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Сканировать QR…" Click="OnScan" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Отмена" IsCancel="True" />
                <Button x:Name="OkButton" Content="Добавить" IsDefault="True" Click="OnAccept" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
