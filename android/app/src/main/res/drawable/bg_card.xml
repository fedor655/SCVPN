<?xml version="1.0" encoding="utf-8"?>
<!--
  Вложенная панель в окнах поверх главного: карточка подписки, поле со
  ссылкой. Скругление одно на всё приложение (8) — раньше соседние панели
  скруглялись на 10 и на 14, и это было видно, когда они стоят рядом.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface" />
    <corners android:radius="@dimen/box_corner" />
    <stroke android:width="@dimen/hairline" android:color="@color/stroke" />
</shape>
