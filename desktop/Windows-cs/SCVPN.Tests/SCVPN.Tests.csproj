<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      TFM с Windows нужен потому, что часть проверок трогает Native (реестр,
      архитектура). Запускать тесты можно только на Windows — там же, где
      приложение и живёт.
    -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <RootNamespace>SCVPN.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SCVPN\SCVPN.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Эталоны читаются с диска, а не встраиваются: так их видно и можно
         сравнить руками, когда тест падает. -->
    <None Include="Golden\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
