<?xml version="1.0" encoding="utf-8"?>
<!--
  Экран раздельного туннелирования.

  Живёт по той же сетке, что главный: поле 16, плоские строки, размеры текста
  из общей шкалы (13 на имена, 12 на выбор, 11 на пояснения). Крупных надписей
  здесь нет намеренно — 26 отданы состоянию подключения на главном экране, и
  второй такой же заголовок спорил бы с ним.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <TextView
        style="@style/Text.RowTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/field"
        android:paddingEnd="@dimen/field"
        android:paddingTop="@dimen/sheet_pad_v"
        android:text="@string/split_title" />

    <TextView
        style="@style/Text.RowDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/field"
        android:paddingEnd="@dimen/field"
        android:paddingTop="@dimen/row_text_spacing"
        android:paddingBottom="@dimen/sheet_gap"
        android:text="@string/split_hint" />

    <RadioGroup
        android:id="@+id/modes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/field"
        android:paddingEnd="@dimen/field"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/mode_auto"
            style="@style/Text.Substatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/row_gap"
            android:text="@string/split_auto"
            android:textColor="@color/text" />

        <RadioButton
            android:id="@+id/mode_off"
            style="@style/Text.Substatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/row_gap"
            android:text="@string/split_off"
            android:textColor="@color/text" />

        <RadioButton
            android:id="@+id/mode_exclude"
            style="@style/Text.Substatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/row_gap"
            android:text="@string/split_exclude"
            android:textColor="@color/text" />

        <RadioButton
            android:id="@+id/mode_include"
            style="@style/Text.Substatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/row_gap"
            android:text="@string/split_include"
            android:textColor="@color/text" />
    </RadioGroup>

    <!-- Поле ввода — вложенная панель, значит скругление общее: 8. -->
    <EditText
        android:id="@+id/search"
        style="@style/Text.Substatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/field"
        android:layout_marginEnd="@dimen/field"
        android:layout_marginTop="@dimen/sheet_gap"
        android:background="@drawable/bg_card"
        android:padding="@dimen/sheet_gap"
        android:hint="@string/split_search"
        android:inputType="text"
        android:maxLines="1"
        android:textColor="@color/text"
        android:textColorHint="@color/muted"
        android:autofillHints="" />

    <ListView
        android:id="@+id/apps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/empty_gap"
        android:paddingBottom="@dimen/list_bottom"
        android:clipToPadding="false"
        android:divider="@drawable/row_divider"
        android:dividerHeight="@dimen/hairline"
        android:footerDividersEnabled="false"
        android:headerDividersEnabled="false"
        android:listSelector="@drawable/row_selector"
        android:scrollbars="none" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/sheet_pad_v" />
</LinearLayout>
