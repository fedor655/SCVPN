# ── Python / десктоп ────────────────────────────────────────────────
__pycache__/
*.pyc
desktop/Windows/.venv/
desktop/Windows/build/
desktop/Windows/dist/
desktop/Windows/dist_installer/
desktop/macOS/.build/
desktop/macOS/dist/

# Профили, настройки и логи: там реальные подписки и ключи серверов.
desktop/Windows/data/
desktop/macOS/data/

# Ядро и гео-базы — приложение качает их само при первом запуске.
desktop/Windows/bin/
desktop/macOS/bin/

# ── Android ─────────────────────────────────────────────────────────
android/.gradle/
android/build/
android/app/build/
# путь к SDK у каждого свой
android/local.properties

# Готовые бинарники сторонних проектов (см. android/README.md).
android/app/libs/*.aar
android/app/src/main/jniLibs/

# Ключ подписи релиза и пароли к нему — никогда в git.
android/*.jks
android/keystore.properties

# ── Прочее ──────────────────────────────────────────────────────────
